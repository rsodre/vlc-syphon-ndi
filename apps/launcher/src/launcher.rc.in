//
// Icon and version information of the Windows launcher (configured by apps/CMakeLists.txt).

#include <winver.h>

1 ICON "@VSN_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VSN_APP_VERSION_COMMAS@
PRODUCTVERSION @VSN_APP_VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Studio Avante"
      VALUE "FileDescription", "@VSN_APP_NAME@ (based on VLC media player)"
      VALUE "FileVersion", "@VSN_APP_VERSION@"
      VALUE "InternalName", "@VSN_APP_NAME@"
      VALUE "LegalCopyright", "Launcher: Roger Sodre and vlc-syphon-ndi contributors (LGPL-2.1+). Starts the official VLC media player by VideoLAN (GPLv2). Not made or endorsed by VideoLAN."
      VALUE "OriginalFilename", "@VSN_APP_NAME@.exe"
      VALUE "ProductName", "@VSN_APP_NAME@"
      VALUE "ProductVersion", "@VSN_APP_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
